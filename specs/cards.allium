-- cards.allium
-- The card market (karaoke, orders, abilities), claiming, clearing rows,
-- orders, and the free-action turn rules for Bartenders of Corfu.
--
-- This file extends game.allium. It supersedes the following rules from that file:
--   ClaimCard          — free action; point rewards per card type; uses ReplaceCardSlot
--   RefreshCardRow     — clearing the orders row / swiping the ability row
--   ReplaceCard        — superseded by ReplaceCardSlot (top of the row's deck)
--   ApplyDrunkModifier — Refresher cards modify drunk calculation
--   SellCup            — CupDoubler, Specialist and order bonuses modify points
--
-- The market has three rows:
--   Row 1 (karaoke): all 5 KaraokeCards, face up. Never cleared or refilled.
--   Row 2 (orders):  3 OrderCards from the shuffled order deck (18 orders).
--   Row 3 (ability): 3 ability cards from the shuffled ability deck (19 cards).
--
-- Ability deck (19 cards):
--   5 × StoreCard       (one per spirit type)
--   4 × RefresherCard   (one per mixer type)
--   2 × CupDoublerCard  (Bendy Straw, Cocktail Umbrella)
--   5 × SpecialistCard  (one per spirit type)
--   3 × FreeActionCard  (RUM, VODKA, GIN)
-- The WHISKEY free-action card (Cocktail Shaker, re-roll specials) is retired
-- along with re-rolling.

use "./game.allium" as game

-- ─── Card types ───────────────────────────────────────────────────────────────
-- Supersedes the Card entity in game.allium.

entity Card {
    id: String
    kind: Karaoke | Store | Refresher | CupDoubler | Specialist | FreeAction | Order
}

variant KaraokeCard : Card {
    spirit_type: WHISKEY | RUM | VODKA | GIN | TEQUILA
    name: String
    -- cost: 3 bladder spirits of this card's spirit_type (stored spirits don't count)
    -- worth 5 points when claimed; counts toward win condition
}

variant StoreCard : Card {
    spirit_type: WHISKEY | RUM | VODKA | GIN | TEQUILA
    name: String
    stored_spirits: List<game/Spirit>
    -- cost: 1 bladder spirit of this card's spirit_type
    -- worth 1 point when claimed
    -- on claim: the cost spirit goes into the bag; every other spirit of
    --   spirit_type in the bladder moves onto this card
    -- stored spirits may be poured into a cup or drunk at any time on the
    --   owner's turn (free actions). Drinking raises drunk level as normal
    -- stored spirits are consumed when spent (not reusable)
    -- stored spirits are unaffected by GoForAWee
}

variant RefresherCard : Card {
    mixer_type: COLA | SODA | TONIC | CRANBERRY
    name: String
    -- cost: 2 bladder mixers of mixer_type
    -- worth 1 point when claimed
    -- ongoing: each mixer of this type always contributes -1 to drunk_level,
    --          even when spirits are consumed in the same action
}

variant CupDoublerCard : Card {
    name: String
    -- cost: 3 bladder spirits all of the same type (player chooses which type at claim time)
    -- worth 2 points when claimed
    -- on claim: player immediately assigns it to one of their cups; that cup scores
    --           double points for all non-cocktail drinks for the rest of the game
}

variant SpecialistCard : Card {
    spirit_type: WHISKEY | RUM | VODKA | GIN | TEQUILA
    name: String
    -- cost: 2 bladder spirits of this card's spirit_type, OR 1 of its special
    --   (WHISKEY: bitters, TEQUILA: cointreau, VODKA: vermouth, RUM: sugar,
    --   GIN: lemon); the player chooses when they could pay either way
    -- worth 2 points when claimed
    -- ongoing: all non-cocktail drinks containing this spirit_type score +2 bonus points
    -- the specialist bonus is applied after cup doubler doubling:
    --   final = (base * cup_doubler_multiplier) + specialist_bonus
    -- cocktails are exempt from the specialist bonus (same exclusion as cup doubler)
}

variant FreeActionCard : Card {
    spirit_type: RUM | VODKA | GIN
    name: String
    free_action_type: take_ingredients | sell_cup | go_for_a_wee
    -- cost: 3 bladder spirits of this card's spirit_type
    -- worth 2 points when claimed
    -- ongoing: grants the player one free additional action of free_action_type per turn.
    -- Mapping:
    --   RUM     → take_ingredients  (Greedy Bartender)
    --   VODKA   → sell_cup          (Entrepreneur)
    --   GIN     → go_for_a_wee      (Weak Bladder)
}

variant OrderCard : Card {
    name: String
    drink: simple | slammer | cocktail
    spirit_type: (WHISKEY | RUM | VODKA | GIN | TEQUILA)?   -- simple and slammer orders
    mixer_type: (COLA | SODA | TONIC | CRANBERRY)?           -- simple orders
    cocktail: String?                                        -- cocktail orders
    bonus: Integer
    -- Not claimable. Served by selling a matching drink (see SellCup):
    --   simple:   a non-cocktail drink of exactly spirit_type and mixer_type,
    --             single or double
    --   slammer:  a Tequila Slammer
    --   cocktail: that named cocktail
}

-- ─── Card catalogue ───────────────────────────────────────────────────────────

default KaraokeCard sea_shanty      = { spirit_type: RUM,     name: "Sea Shanty" }
default KaraokeCard cringey_crooner = { spirit_type: GIN,     name: "Cringey Crooner" }
default KaraokeCard dazzling_duet   = { spirit_type: TEQUILA, name: "Dazzling Duet" }
default KaraokeCard party_tune      = { spirit_type: VODKA,   name: "Party Tune" }
default KaraokeCard ballad_master   = { spirit_type: WHISKEY, name: "Ballad Master" }

default StoreCard rum_store     = { spirit_type: RUM,     name: "Rum Store",     stored_spirits: [] }
default StoreCard gin_store     = { spirit_type: GIN,     name: "Gin Store",     stored_spirits: [] }
default StoreCard tequila_store = { spirit_type: TEQUILA, name: "Tequila Store", stored_spirits: [] }
default StoreCard vodka_store   = { spirit_type: VODKA,   name: "Vodka Store",   stored_spirits: [] }
default StoreCard whisky_store  = { spirit_type: WHISKEY, name: "Whisky Store",  stored_spirits: [] }

default RefresherCard cola_refresher      = { mixer_type: COLA,      name: "Cola Refresher" }
default RefresherCard soda_refresher      = { mixer_type: SODA,      name: "Soda Refresher" }
default RefresherCard tonic_refresher     = { mixer_type: TONIC,     name: "Tonic Refresher" }
default RefresherCard cranberry_refresher = { mixer_type: CRANBERRY, name: "Cranberry Refresher" }

default CupDoublerCard bendy_straw       = { name: "Bendy Straw" }
default CupDoublerCard cocktail_umbrella = { name: "Cocktail Umbrella" }

default SpecialistCard rum_specialist     = { spirit_type: RUM,     name: "Rum Specialist" }
default SpecialistCard gin_specialist     = { spirit_type: GIN,     name: "Gin Specialist" }
default SpecialistCard tequila_specialist = { spirit_type: TEQUILA, name: "Tequila Specialist" }
default SpecialistCard vodka_specialist   = { spirit_type: VODKA,   name: "Vodka Specialist" }
default SpecialistCard whisky_specialist  = { spirit_type: WHISKEY, name: "Whisky Specialist" }

default FreeActionCard greedy_bartender = { spirit_type: RUM,   name: "Greedy Bartender", free_action_type: take_ingredients }
default FreeActionCard entrepreneur     = { spirit_type: VODKA, name: "Entrepreneur",     free_action_type: sell_cup }
default FreeActionCard weak_bladder     = { spirit_type: GIN,   name: "Weak Bladder",     free_action_type: go_for_a_wee }

-- 18 orders:
--   simple (+2): Vodka and Cola, Vodka Soda, Vodka Tonic, Vodka Cranberry,
--                Rum and Cola, Whisky and Cola, Whisky Soda, Gin and Tonic
--   slammer (+3): Tequila Slammer
--   cocktail (+4): Mojito, Old Fashioned, Margarita, Cosmopolitan, Gin Martini,
--                  Vodka Martini, Tom Collins, Manhattan
--   cocktail (+5): Long Island Iced Tea

-- ─── Config ───────────────────────────────────────────────────────────────────

config {
    karaoke_card_points:    Integer = 5
    store_card_points:      Integer = 1
    refresher_card_points:  Integer = 1
    cup_doubler_card_points: Integer = 2
    specialist_card_points:  Integer = 2
    specialist_sell_bonus:   Integer = 2    -- added to non-cocktail drink score per matching specialist
    free_action_card_points: Integer = 2
    simple_order_bonus:      Integer = 2
    slammer_order_bonus:     Integer = 3
    cocktail_order_bonus:    Integer = 4
    long_island_order_bonus: Integer = 5
    row_size:                Integer = 3    -- orders and ability rows
}

-- ─── Cup amendment ────────────────────────────────────────────────────────────
-- Adds has_cup_doubler to game/Cup. Set permanently when a CupDoublerCard is
-- assigned to this cup at claim time.

amendment game/Cup {
    has_cup_doubler: Boolean = false
}

-- ─── Selling (amended) ────────────────────────────────────────────────────────
-- Supersedes game/SellCup for the points calculation. A player may sell one
-- cup or both cups in one action; each cup is scored on its own.

rule SellCup {
    when: SellCup(player, cups: List<(cup, declared_specials)>)
    requires: player.status = active
    requires: it is player's turn
    requires: 1 <= cups.count <= 2, no cup twice
    requires: all declared_specials together ⊆ player.special_ingredients  -- legacy games; else empty
    requires: each (cup, declared_specials) is a valid sellable drink
    -- A cup's specials are the ones in it plus any declared (legacy games).
    for (cup, declared_specials) in cups:
        let base_points = drink_points(cup, declared_specials)
        let is_cocktail = (cup, declared_specials) matches a named cocktail recipe
        let doubled_points = base_points * 2 when cup.has_cup_doubler and not is_cocktail, else base_points
        -- Specialist bonus: +specialist_sell_bonus per spirit type in the cup that
        -- the player holds a SpecialistCard for. Cocktails are exempt.
        let specialist_bonus = matching_specialists * config.specialist_sell_bonus when not is_cocktail, else 0
        -- Order bonus: the first order in the orders row this drink matches is
        -- served. Its bonus is added flat (never doubled). The order goes to the
        -- bottom of the order deck and ReplaceCardSlot refills the row.
        let order = first OrderCard in orders row matching (cup, declared_specials)
        let order_bonus = order.bonus when order exists, else 0
        ensures: player.points = player.points + doubled_points + specialist_bonus + order_bonus
        ensures: player.special_ingredients = player.special_ingredients - declared_specials
        ensures: board.bag_contents = board.bag_contents + cup.ingredients (before sale)
        ensures: cup.ingredients = []
    -- Specials in a cup go back in the bag with it; declared ones (legacy
    -- games) return to the supply.
    ensures: CheckVictory(player)
    -- Selling (one cup or both) is one main action.
}

-- ─── Setup ────────────────────────────────────────────────────────────────────

rule SetupCardRows {
    when: GameStarted()
    let order_deck   = shuffle(all 18 OrderCards)
    let ability_deck = shuffle(all 19 ability cards)
    ensures: game/CardRow.created(position: 1, cards: all 5 KaraokeCards)
    ensures: game/CardRow.created(position: 2, cards: first config.row_size of order_deck)
    ensures: game/CardRow.created(position: 3, cards: first config.row_size of ability_deck)
    ensures: both decks keep the rest, drawn from the top
}

-- ─── Slot replacement ─────────────────────────────────────────────────────────
-- Supersedes game/ReplaceCard.

rule ReplaceCardSlot {
    when: ReplaceCardSlot(board, row)
    requires: row.position != 1          -- the karaoke row is never refilled
    let deck = order_deck when row.position = 2, else ability_deck
    if deck.count > 0:
        ensures: the top card of deck moves into row
    -- If the deck is empty, the slot stays empty.
}

-- ─── Claiming a card (amended) ────────────────────────────────────────────────
-- Supersedes game/ClaimCard. Claiming is always a free action, once per turn.

rule ClaimCard {
    when: ClaimCard(player, card)
    requires: player.status = active
    requires: it is player's turn
    requires: no TakeIngredients batch is in progress
    requires: "claim_card" not in free_actions_used_this_turn
    requires: card in row 1 or row 3            -- orders can't be claimed
    requires card.kind = Karaoke:
        player.bladder where spirit_type = card.spirit_type has count >= 3
    requires card.kind = Store:
        player.bladder where spirit_type = card.spirit_type has count >= 1
    requires card.kind = Refresher:
        player.bladder where mixer_type = card.mixer_type has count >= 2
    requires card.kind = CupDoubler:
        player.bladder has 3 or more spirits all of the same spirit_type
        -- player declares the spirit type and the cup at claim time
    requires card.kind = Specialist:
        player.bladder where spirit_type = card.spirit_type has count >= 2
        or player.bladder contains specialist_special(card.spirit_type)
    requires card.kind = FreeAction:
        player.bladder where spirit_type = card.spirit_type has count >= 3
    -- The cost is paid: exactly the cost's ingredients leave the bladder and
    -- go back into the bag.
    let paid = the cost's ingredients (for a Specialist: 1 special or 2 spirits,
               the special by default when held)
    ensures: player.bladder = player.bladder - paid
    ensures: board.bag_contents = board.bag_contents + paid
    if card.kind = Karaoke:
        ensures: player.points = player.points + config.karaoke_card_points
        ensures: player.karaoke_cards_claimed = player.karaoke_cards_claimed + 1
    if card.kind = Store:
        let transferred = (player.bladder - paid) where spirit_type = card.spirit_type
        ensures: player.bladder = player.bladder - transferred
        ensures: card.stored_spirits = transferred
        ensures: player.points = player.points + config.store_card_points
    if card.kind = Refresher:
        ensures: player.points = player.points + config.refresher_card_points
    if card.kind = CupDoubler:
        ensures: cup.has_cup_doubler = true
        ensures: player.points = player.points + config.cup_doubler_card_points
    if card.kind = Specialist:
        ensures: player.points = player.points + config.specialist_card_points
    if card.kind = FreeAction:
        ensures: player.points = player.points + config.free_action_card_points
    ensures: player.cards = player.cards + [card]
    ensures: card removed from its CardRow
    if card in row 3:
        ensures: ReplaceCardSlot(board, row 3)
    ensures: free_actions_used_this_turn = free_actions_used_this_turn + ["claim_card"]
    ensures: CheckVictory(player)
}

-- ─── Clearing rows (amended) ──────────────────────────────────────────────────
-- Supersedes game/RefreshCardRow.

rule RefreshCardRow {
    when: RefreshCardRow(player, row)
    requires: player.status = active
    requires: it is player's turn
    requires: no TakeIngredients batch is in progress
    requires: row.position != 1                  -- the karaoke row is never cleared
    requires row.position = 2:                   -- clearing the orders: free action
        player.drunk_level >= game/config.min_drunk_to_refresh
        and "refresh_orders_row" not in free_actions_used_this_turn
    requires row.position = 3:                   -- swiping the abilities: free action
        player.drunk_level >= game/config.min_drunk_to_swipe
        and "refresh_ability_row" not in free_actions_used_this_turn
    ensures: every card in row goes to the bottom of its deck, in order
    ensures: config.row_size new cards are dealt from the top (fewer if the deck runs out)
    if row.position = 2:
        ensures: free_actions_used_this_turn = free_actions_used_this_turn + ["refresh_orders_row"]
    if row.position = 3:
        ensures: free_actions_used_this_turn = free_actions_used_this_turn + ["refresh_ability_row"]
}

-- ─── Drunk calculation (amended) ─────────────────────────────────────────────
-- Supersedes game/ApplyDrunkModifier.
-- Refresher cards make their mixer type contribute -1 to drunk_level on every
-- action, even when spirits are also consumed in the same action.

rule ApplyDrunkModifier {
    when: ApplyDrunkModifier(player, consumed: List<Ingredient>)
    let boozy        = {bitters, cointreau, vermouth}
    let spirits      = consumed where kind = Spirit
                                   or (kind = Special and special_type in boozy)
    let refresher_mixer_types = { card.mixer_type for card in player.cards where kind = Refresher }
    let hot_mixers   = consumed where kind = Mixer and mixer_type in refresher_mixer_types
    let plain_mixers = consumed where (kind = Mixer and mixer_type not in refresher_mixer_types)
                                   or (kind = Special and special_type not in boozy)
    -- Spirits (and bitters, cointreau, vermouth) raise drunk level; hot_mixers
    -- always lower it (-1 each); plain mixers, lemon and sugar lower it only
    -- when none of those were consumed.
    let delta = spirits.count - hot_mixers.count
    if spirits.count = 0:
        let delta = delta - plain_mixers.count
    ensures: player.drunk_level = max(0, player.drunk_level + delta)
    ensures: CheckElimination(player)
}

-- ─── Free action turn rules ──────────────────────────────────────────────────
-- A turn is one main action (TakeIngredients, SellCup, DrinkCup, GoForAWee)
-- plus free actions, each at most once per turn:
--   claim_card           — always available (ClaimCard)
--   refresh_orders_row   — always available at drunk 3+ (clearing row 2)
--   refresh_ability_row  — always available at drunk 2+ (swiping row 3)
--   take_ingredients / sell_cup / go_for_a_wee — granted by FreeActionCards
-- DrinkStoredSpirit and UseStoredSpirit are free and unlimited.

amendment game/BoardState {
    main_action_taken_this_turn: Boolean = false
    free_actions_used_this_turn: List<String> = []
}

rule FreeActionTurnLogic {
    -- When a player performs a turn action:
    --   If the action type is an unused free action for the player → it is
    --   free; record it in free_actions_used_this_turn.
    --   Otherwise, if main_action_taken is false → it is the main action.
    --   Otherwise → reject: "You have already taken your main action this turn".
    --
    -- After the action: the turn advances when main_action_taken is true AND no
    -- unused free action could be used right now. claim_card counts only while
    -- the player can afford a card in row 1 or row 3; refresh_orders_row only
    -- at drunk 3+ with orders to clear; refresh_ability_row only at drunk 2+
    -- with ability cards to swipe. Card-granted free actions count
    -- while unused.
    requires: true  -- applied inline in each action handler
}

rule EndTurn {
    -- A player may explicitly end their turn, forfeiting any unused free actions.
    when: EndTurn(player)
    requires: player.status = active
    requires: it is player's turn
    requires: main_action_taken_this_turn = true
    requires: at least one unused free action could be used
    ensures: turn advances to next active player
    ensures: main_action_taken_this_turn = false
    ensures: free_actions_used_this_turn = []
}

-- ─── Game modes ──────────────────────────────────────────────────────────────
-- There are no optional modes. The former ones were settled: sell_both_cups
-- and claim_card_free_action are standard rules; reroll_specials_free_action
-- went with re-rolling. Saved games that list them still load and ignore them.

amendment game/BoardState {
    game_modes: List<String> = []
}

-- ─── Guarantees ───────────────────────────────────────────────────────────────

guarantee: row 1 holds all 5 karaoke cards at game start and is never cleared or refilled
guarantee: row 2 holds only order cards; row 3 holds only ability cards
guarantee: cleared cards go to the bottom of their own deck; nothing is discarded for good
guarantee: order cards are never claimed; a sale serves at most one order per cup
guarantee: order bonuses are never doubled and never get the specialist bonus
guarantee: claiming a card moves exactly its cost from the bladder into the bag
guarantee: stored spirits never count toward a card cost; specials only pay for a specialist
guarantee: the Store card effect (transferring spirits to stored_spirits) is not a cost consumption
guarantee: ClaimCard for a CupDoubler card requires a cup parameter; invalid without one
guarantee: cup.has_cup_doubler is set at claim time and never cleared; persists through sell/refill cycles
guarantee: the CupDoubler doubling applies only to non-cocktail scoring categories (3–5 in game.allium)
guarantee: stored spirits on a StoreCard are unaffected by GoForAWee
guarantee: stored spirits are consumed (removed from the card) when spent on an action
guarantee: the Specialist sell bonus applies only to non-cocktail scoring categories (3–5 in game.allium)
guarantee: the Specialist sell bonus is applied after cup doubler doubling: final = doubled_points + specialist_bonus
guarantee: multiple specialist cards stack: a cup with 2 matching spirit types adds the bonus for each
guarantee: claiming a card is always a free action, at most once per turn
guarantee: swiping the ability row is a free action at most once per turn
guarantee: clearing the orders row is a free action at most once per turn
guarantee: a partial TakeIngredients batch blocks ClaimCard and RefreshCardRow until the take is finished
guarantee: a free action only holds the turn open while it could be used
guarantee: FreeActionCard free_action_type is visible to all players on the claimed card
